---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import { t } from "../../lib/i18n/ui";
import { localizeUrl } from "../../lib/i18n/routing";

export const prerender = true;

const locale = "es" as const;
const home = localizeUrl("/", locale);
---

<BaseLayout
  locale={locale}
  title={`${t("thanks.title", locale)} | Southstorm Mechanical`}
  description={t("thanks.lead", locale)}
>
  <section class="section-pad bg-paper min-h-[60vh] flex items-center">
    <div class="wrap text-center max-w-[720px]">
      <p class="eyebrow text-accent justify-center">✓</p>
      <h1 class="text-[clamp(2.6rem,6vw,4.4rem)] mt-6 text-navy-900">{t("thanks.title", locale)}</h1>
      <p class="mt-6 text-[18px] text-slate-ink">{t("thanks.lead", locale)}</p>
      <a href={home} class="btn btn--primary mt-10">{t("thanks.home", locale)}</a>
    </div>
  </section>
</BaseLayout>
