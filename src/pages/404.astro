---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { t } from "../lib/i18n/ui";

const locale = "en" as const;
---

<BaseLayout
  locale={locale}
  title="Page not found | Southstorm Mechanical"
  description="The page you requested does not exist."
>
  <section class="section-pad bg-navy-950 text-white min-h-[60vh] flex items-center">
    <div class="wrap text-center">
      <p class="font-mono text-[13px] tracking-[0.2em] text-electric-soft">ERROR 404</p>
      <h1 class="text-[clamp(3rem,9vw,7rem)] mt-5">Page not found</h1>
      <div class="hairline-accent mx-auto mt-8"></div>
      <a href="/" class="btn btn--primary mt-10">{t("thanks.home", locale)}</a>
    </div>
  </section>
</BaseLayout>
