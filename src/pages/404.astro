---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { t } from "../lib/i18n/ui";

const locale = "en" as const;
---

<BaseLayout
  locale={locale}
  title="Page not found | Southstorm Mechanical"
  description="The page you requested does not exist."
>
  <section class="section-pad bg-paper min-h-[60vh] flex items-center">
    <div class="wrap text-center">
      <p class="eyebrow text-accent justify-center">404</p>
      <h1 class="text-[clamp(2.6rem,7vw,5rem)] mt-5 text-navy-900">Page not found</h1>
      <a href="/" class="btn btn--primary mt-10">{t("thanks.home", locale)}</a>
    </div>
  </section>
</BaseLayout>
