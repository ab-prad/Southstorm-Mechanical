---
/**
 * Small inline contact icons. `currentColor` makes them inherit the text
 * color, so they follow hover/focus states without extra CSS.
 */
interface Props {
  name: "phone" | "mail" | "whatsapp";
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = "" } = Astro.props;
---

{
  name === "phone" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={["shrink-0", className]}
      aria-hidden="true"
      focusable="false"
    >
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z" />
    </svg>
  )
}

{
  name === "mail" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={["shrink-0", className]}
      aria-hidden="true"
      focusable="false"
    >
      <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
      <path d="m3 6.5 9 6.5 9-6.5" />
    </svg>
  )
}

{
  name === "whatsapp" && (
    /* Filled brand glyph: a stroke drawing turns to mud at 15-17px. The handset
       is negative space inside the same fill, so it stays crisp and recognizable. */
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      class:list={["shrink-0", className]}
      aria-hidden="true"
      focusable="false"
    >
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.15c-1.53 0-3.03-.41-4.34-1.2l-.31-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.4c0-4.52 3.68-8.2 8.2-8.2 2.19 0 4.25.85 5.8 2.4A8.15 8.15 0 0 1 21 11.95c0 4.52-3.68 8.2-8.2 8.2zm4.52-6.15c-.25-.13-1.47-.73-1.69-.81-.22-.09-.39-.13-.56.13-.16.25-.64.81-.79.98-.14.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.74-.86-1.35-1.66-1.51-1.9-.16-.25-.17-.44-.17-.47 0-.03.16-.29.31-.43.12-.12.16-.2.25-.33.08-.12.04-.25-.02-.37-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.41-.56-.42h-.48c-.16 0-.44.06-.67.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.12.16 1.75 2.67 4.23 3.75.59.25 1.05.4 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.29z" />
    </svg>
  )
}
