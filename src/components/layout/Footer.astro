---
import { t } from "../../lib/i18n/ui";
import { localizeUrl, type Locale } from "../../lib/i18n/routing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = localizeUrl("/", locale);
const year = new Date().getFullYear();
---

<footer class="bg-surface">
  <div class="wrap py-14 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <img src="/logo.png" alt="Southstorm Mechanical" width="170" height="41" class="h-[54px] w-auto" />
      <p class="font-display text-[25px] mt-5 max-w-[24ch] leading-snug text-navy-900">
        {t("footer.tagline", locale)}
      </p>
      <p class="text-[13px] text-slate-muted mt-4">
        {t("footer.services", locale)}
      </p>
    </div>

    <div>
      <h3 class="text-[13px] font-bold text-accent mb-4">Contact</h3>
      <ul class="space-y-3 text-[15px] text-slate-ink">
        <li>
          <a href="tel:+15617884360" class="hover:text-accent transition-colors">561-788-4360</a>
        </li>
        <li>
          <a href="mailto:support@southstormmechanical.com" class="hover:text-accent transition-colors">
            support@southstormmechanical.com
          </a>
        </li>
        <li>
          <a href="https://wa.me/+15617884360" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
            WhatsApp
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h3 class="text-[13px] font-bold text-accent mb-4">Links</h3>
      <ul class="space-y-3 text-[15px] text-slate-ink">
        <li><a href={`${home}#services`} class="hover:text-accent transition-colors">{t("nav.services", locale)}</a></li>
        <li><a href={`${home}#faq`} class="hover:text-accent transition-colors">{t("nav.faq", locale)}</a></li>
        <li>
          <a
            href="https://client.housecallpro.com/customer_portal/request-link?token=b2911794837248609d94e7f920f695b5"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent transition-colors"
          >
            {t("nav.portal", locale)}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-navy-900/5">
    <div class="wrap py-5 flex flex-col sm:flex-row gap-2 justify-between text-[13px] text-slate-muted">
      <span>© {year} Southstorm Mechanical. {t("footer.rights", locale)}</span>
      <span>{t("trust.spanish", locale)} · {t("footer.built", locale)}</span>
    </div>
  </div>
</footer>
