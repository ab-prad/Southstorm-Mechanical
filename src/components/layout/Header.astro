---
import { t } from "../../lib/i18n/ui";
import { localizeUrl, getAlternateUrl, type Locale } from "../../lib/i18n/routing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = localizeUrl("/", locale);
const altPath = getAlternateUrl(Astro.url.pathname, locale);
const otherLocale: Locale = locale === "en" ? "es" : "en";
const otherLabel = otherLocale.toUpperCase();
const langSwapAria = locale === "en" ? "Cambiar a español" : "Switch to English";

const navLinks = [
  { href: `${home}#services`, label: t("nav.services", locale) },
  { href: `${home}#faq`, label: t("nav.faq", locale) },
  { href: `${home}#contact`, label: t("nav.contact", locale) },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-navy-900/10">
  <div class="wrap grid grid-cols-[auto_1fr_auto] items-center gap-4 py-3">
    <a href={home} class="flex items-center gap-3" aria-label="Southstorm Mechanical">
      <img src="/logo.png" alt="" width="118" height="30" class="h-[34px] w-auto" />
    </a>

    <nav class="hidden md:flex items-center justify-center gap-8" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-mono text-[11px] tracking-[0.14em] uppercase text-navy-900/70 hover:text-electric transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5 justify-self-end">
      <a
        href={altPath}
        onclick={`localStorage.setItem('preferredLocale','${otherLocale}')`}
        aria-label={langSwapAria}
        class="font-mono text-[11px] tracking-[0.1em] uppercase px-2.5 py-2 rounded border border-navy-900/25 text-navy-900 hover:bg-white transition-colors"
      >
        {otherLabel}
      </a>
      <a
        href="tel:+15617884360"
        class="btn btn--primary hidden sm:inline-flex !py-2.5 !px-4"
      >
        {t("nav.call", locale)}
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded border border-navy-900/25 text-navy-900"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t("nav.menu", locale)}
        data-open-label={t("nav.menu", locale)}
        data-close-label={t("nav.closeMenu", locale)}
      >
        <svg class="icon-bars" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-close hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu md:hidden border-t border-navy-900/10 bg-white" hidden>
    <nav class="wrap py-4 flex flex-col">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link flex items-center min-h-[48px] px-1 text-navy-900 border-b border-navy-900/10 font-display text-[22px] uppercase"
        >
          {link.label}
        </a>
      ))}
      <a href="tel:+15617884360" class="btn btn--primary mt-4">
        {t("nav.call", locale)}
      </a>
    </nav>
  </div>
</header>
