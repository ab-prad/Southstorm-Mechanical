---
import { t } from "../../lib/i18n/ui";
import type { Locale } from "../../lib/i18n/routing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const items = [
  { label: t("trust.spanish", locale), icon: "ES" },
  { label: t("trust.brands", locale), icon: "ALL" },
  { label: t("trust.emergency", locale), icon: "24" },
  { label: t("trust.area", locale), icon: "FL" },
];
---

<section class="bg-paper" aria-label="Highlights">
  <div class="wrap grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-4 py-4 pb-10">
    {items.map((item) => (
      <div class="flex items-center gap-3">
        <span class="soft-chip !text-[11px] shrink-0 !bg-accent-wash !text-accent">
          {item.icon}
        </span>
        <span class="text-[14px] md:text-[15px] font-semibold leading-tight text-navy-900">
          {item.label}
        </span>
      </div>
    ))}
  </div>
</section>
