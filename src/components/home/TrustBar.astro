---
import { t } from "../../lib/i18n/ui";
import type { Locale } from "../../lib/i18n/routing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const items = [
  { label: t("trust.spanish", locale), icon: "ES" },
  { label: t("trust.brands", locale), icon: "◇" },
  { label: t("trust.emergency", locale), icon: "24" },
  { label: t("trust.area", locale), icon: "FL" },
];
---

<section class="border-y border-navy-900/10 bg-surface" aria-label="Highlights">
  <div class="wrap grid grid-cols-2 lg:grid-cols-4 divide-x divide-navy-900/10">
    {items.map((item) => (
      <div class="flex items-center gap-3 px-2 py-5 lg:px-6">
        <span class="font-mono text-[12px] tracking-[0.08em] border border-navy-900/30 text-navy-900 px-2 py-1 shrink-0">
          {item.icon}
        </span>
        <span class="font-display text-[15px] md:text-[18px] uppercase tracking-[0.02em] leading-tight text-navy-900">
          {item.label}
        </span>
      </div>
    ))}
  </div>
</section>
