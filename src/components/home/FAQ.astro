---
import { t } from "../../lib/i18n/ui";
import Eyebrow from "../ui/Eyebrow.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import type { Locale } from "../../lib/i18n/routing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const items = [
  { q: t("faq.q1", locale), a: t("faq.a1", locale) },
  { q: t("faq.q2", locale), a: t("faq.a2", locale) },
  { q: t("faq.q3", locale), a: t("faq.a3", locale) },
  { q: t("faq.q4", locale), a: t("faq.a4", locale) },
];
---

<section id="faq" class="section-pad bg-paper">
  <div class="wrap relative">
    <div class="reveal">
      <Eyebrow>{t("faq.eyebrow", locale)}</Eyebrow>
      <SectionHeading>{t("faq.title", locale)}</SectionHeading>
    </div>

    <div class="mt-10 max-w-[860px] grid gap-3">
      {items.map((item, index) => (
        <details class="reveal faq-item group rounded-2xl bg-white border border-navy-900/5 shadow-sm" name="faq">
          <summary class="flex items-center justify-between gap-6 px-6 py-5 cursor-pointer list-none marker:hidden">
            <span class="flex items-start gap-4">
              <span class="soft-chip !text-[12px] !bg-accent/10 !text-accent pt-1.5">
                0{index + 1}
              </span>
              <span class="font-display text-[19px] md:text-[21px] leading-snug text-navy-900">
                {item.q}
              </span>
            </span>
            <span class="faq-icon shrink-0 w-9 h-9 rounded-full bg-surface flex items-center justify-center text-[20px] text-navy-900 transition-colors group-open:bg-navy-900 group-open:text-white" aria-hidden="true">+</span>
          </summary>
          <p class="px-6 pb-6 pl-[4.6rem] text-[15px] leading-relaxed text-slate-ink max-w-[65ch]">
            {item.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
