---
import { t } from "../../lib/i18n/ui";
import Eyebrow from "../ui/Eyebrow.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import type { Locale } from "../../lib/i18n/routing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const items = [
  { q: t("faq.q1", locale), a: t("faq.a1", locale) },
  { q: t("faq.q2", locale), a: t("faq.a2", locale) },
  { q: t("faq.q3", locale), a: t("faq.a3", locale) },
  { q: t("faq.q4", locale), a: t("faq.a4", locale) },
];
---

<section id="faq" class="section-pad bg-paper">
  <div class="wrap relative">
    <div class="reveal">
      <Eyebrow>{t("faq.eyebrow", locale)}</Eyebrow>
      <SectionHeading>{t("faq.title", locale)}</SectionHeading>
      <div class="hairline-accent mt-7"></div>
    </div>

    <div class="mt-12 max-w-[820px] divide-y divide-navy-900/10">
      {items.map((item, index) => (
        <details class="reveal faq-item group" name="faq">
          <summary class="flex items-center justify-between gap-6 py-6 cursor-pointer list-none marker:hidden">
            <span class="flex items-start gap-5">
              <span class="font-mono text-[12px] tracking-[0.14em] text-electric pt-1.5">
                0{index + 1}
              </span>
              <span class="font-display text-[22px] md:text-[26px] uppercase leading-tight text-navy-900">
                {item.q}
              </span>
            </span>
            <span class="faq-icon shrink-0 w-9 h-9 border border-navy-900/25 text-navy-900 flex items-center justify-center font-mono text-lg transition-colors group-open:bg-navy-900 group-open:text-white group-open:border-navy-900" aria-hidden="true">+</span>
          </summary>
          <p class="pl-[2.6rem] pr-10 pb-7 text-[15px] leading-relaxed text-slate-ink max-w-[65ch]">
            {item.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
