---
import { t } from "../../lib/i18n/ui";
import type { Locale } from "../../lib/i18n/routing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="relative overflow-hidden bg-paper">
  <div class="absolute -top-28 -right-20 w-[460px] h-[460px] rounded-full bg-accent-wash" aria-hidden="true"></div>

  <div class="wrap relative py-24 md:py-32 grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="reveal">
      <p class="eyebrow text-accent">{t("hero.eyebrow", locale)}</p>
      <h1 class="text-[clamp(2.6rem,6vw,4.4rem)] mt-5 text-navy-900 max-w-[16ch]">
        {t("hero.title", locale)}
      </h1>
      <p class="mt-6 text-[18px] leading-relaxed text-slate-ink max-w-[52ch]">
        {t("hero.lead", locale)}
      </p>
      <p class="mt-3 text-[15px] font-semibold text-navy-900">
        <span class="ink-underline">{t("trust.spanish", locale)}</span>
        <span class="text-slate-muted font-normal"> · {t("trust.area", locale)}</span>
      </p>
      <p class="mt-6 soft-chip !text-[13px]">
        <span class="text-accent" aria-hidden="true">✓</span>
        {t("hero.promo", locale)}
      </p>

      <div class="mt-9 flex flex-wrap gap-4">
        <a href="tel:+15617884360" class="btn btn--primary">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"></path>
          </svg>
          {t("hero.cta.call", locale)}
        </a>
        <a
          href="https://book.housecallpro.com/book/SOUTHSTORM-MECHANICAL/2c320fb8d05a42a883a7b66c0c48a7c5?v2=true"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--ghost text-navy-900"
        >
          {t("hero.cta.book", locale)}
        </a>
      </div>
    </div>

    <div class="reveal relative" style="animation-delay: 120ms">
      <div class="relative rounded-3xl border border-navy-900/5 bg-white p-3 shadow-xl shadow-navy-900/5">
        <img
          src="/hero-hvac.jpg"
          alt={t("hero.imageAlt", locale)}
          width="1200"
          height="900"
          class="w-full h-[340px] md:h-[440px] object-cover rounded-2xl"
        />
        <div class="absolute -bottom-5 -left-5 rounded-xl bg-white border border-navy-900/10 px-5 py-3 shadow-lg">
          <span class="block text-[11px] font-bold uppercase tracking-wide text-accent">{t("nav.call", locale)}</span>
          <a href="tel:+15617884360" class="font-display text-[22px] text-navy-900 leading-tight">561-788-4360</a>
        </div>
      </div>
    </div>
  </div>
</section>
