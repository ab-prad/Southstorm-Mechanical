---
import { t } from "../../lib/i18n/ui";
import Eyebrow from "../ui/Eyebrow.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import type { Locale } from "../../lib/i18n/routing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Descriptions are the owner's copy, re-assigned to the correct service.
// The Squarespace original had repair/maintenance/emergency swapped.
const services = [
  {
    num: "01",
    title: t("service.repair.title", locale),
    desc: t("service.repair.desc", locale),
  },
  {
    num: "02",
    title: t("service.maintenance.title", locale),
    desc: t("service.maintenance.desc", locale),
  },
  {
    num: "03",
    title: t("service.emergency.title", locale),
    desc: t("service.emergency.desc", locale),
  },
];
---

<section id="services" class="section-pad bg-paper">
  <div class="wrap">
    <div class="reveal flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <Eyebrow>{t("services.eyebrow", locale)}</Eyebrow>
        <SectionHeading>{t("services.title", locale)}</SectionHeading>
      </div>
      <p class="font-mono text-[11px] tracking-[0.12em] uppercase text-slate-muted">
        {t("trust.area", locale)}
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {services.map((service) => (
        <article class="reveal service-card group relative bg-white border border-navy-900/10 p-8 pt-10 min-h-[300px] flex flex-col overflow-hidden">
          <span class="font-mono text-[12px] tracking-[0.16em] text-electric">
            {service.num}
          </span>
          <div class="absolute top-0 left-0 h-[3px] w-0 bg-electric transition-all duration-300 group-hover:w-full" aria-hidden="true"></div>
          <h3 class="text-[38px] mt-6 text-navy-900">
            {service.title}
          </h3>
          <p class="mt-5 text-[15px] leading-relaxed text-slate-ink">
            {service.desc}
          </p>
          <div class="mt-auto pt-8">
            <span class="font-mono text-[11px] tracking-[0.14em] uppercase text-slate-muted group-hover:text-electric transition-colors">
              + {t("nav.call", locale)}
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
