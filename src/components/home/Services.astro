---
import { t } from "../../lib/i18n/ui";
import Eyebrow from "../ui/Eyebrow.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import type { Locale } from "../../lib/i18n/routing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Descriptions are the owner's copy, re-assigned to the correct service.
// The Squarespace original had repair/maintenance/emergency swapped.
const services = [
  {
    num: "01",
    title: t("service.repair.title", locale),
    desc: t("service.repair.desc", locale),
  },
  {
    num: "02",
    title: t("service.maintenance.title", locale),
    desc: t("service.maintenance.desc", locale),
  },
  {
    num: "03",
    title: t("service.emergency.title", locale),
    desc: t("service.emergency.desc", locale),
  },
];
---

<section id="services" class="section-pad bg-paper">
  <div class="wrap">
    <div class="reveal flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <Eyebrow>{t("services.eyebrow", locale)}</Eyebrow>
        <SectionHeading>{t("services.title", locale)}</SectionHeading>
      </div>
      <p class="text-[14px] text-slate-muted">
        {t("trust.area", locale)}
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {services.map((service) => (
        <article class="reveal service-card group relative rounded-3xl border border-navy-900/5 bg-white p-8 pt-9 min-h-[290px] flex flex-col shadow-md shadow-navy-900/5 transition-shadow hover:shadow-xl hover:shadow-navy-900/10">
          <span class="soft-chip !text-[12px] !bg-accent/10 !text-accent self-start">
            {service.num}
          </span>
          <h3 class="text-[28px] mt-6 text-navy-900">
            {service.title}
          </h3>
          <p class="mt-4 text-[15px] leading-relaxed text-slate-ink">
            {service.desc}
          </p>
          <div class="mt-auto pt-8">
            <span class="text-[13px] font-semibold text-slate-muted group-hover:text-accent transition-colors">
              + {t("nav.call", locale)}
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
